# Copy to .env.local (ignored by git). See docs/GOOGLE_SETUP.md.
# Optional: overrides the built-in default client ID (web and desktop each have one in settings.ts).
VITE_GOOGLE_CLIENT_ID=
# Desktop builds only (`npm run tauri dev`/`build`). Put the real value in .env.local, never in this file. Do NOT set this for a web deployment: it would be bundled into the public JS.
VITE_GOOGLE_CLIENT_SECRET=
