# Copy to .env.local (ignored by git). See docs/GOOGLE_SETUP.md.
# Optional: overrides the built-in default client ID (see DEFAULT_GOOGLE_CLIENT_ID in settings.ts).
VITE_GOOGLE_CLIENT_ID=
# Desktop builds only. Do NOT set this for a web deployment: it would be bundled into the public JS.
VITE_GOOGLE_CLIENT_SECRET=
